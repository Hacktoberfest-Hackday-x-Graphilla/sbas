# Copy this file to .env
# Choose ONE provider. Both are optional because the app has an offline fallback.
AI_PROVIDER=openrouter

# OpenRouter free routing. You can replace with another free model if needed.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SITE_URL=http://127.0.0.1:5000
OPENROUTER_APP_NAME=RealAI Toolkit

# Google Gemini free-tier API option
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
